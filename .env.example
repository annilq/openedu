# 复制为 .env 后填写。后端从仓库根目录的 .env 读取。
PROJECT_NAME=娃娃学习App
SECRET_KEY=请改为随机字符串

# 本地用 SQLite；部署到云用 PostgreSQL 连接串
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

FASTAPI_ENV=development

# 模型经「模型管理」配置，无本地 mock 兜底；未配置模型时出题/答疑/批改返回「未配置模型」提示。
# 管理员预设：BUILTIN_MODELS 为 JSON 数组，provder ∈ {ollama, openai_compat}。
#   - 本地 Ollama 示例（需先起 Ollama 并拉好模型）：
BUILTIN_MODELS=[{"id":"local-llama","provider":"ollama","base_url":"http://localhost:11434","model_name":"qwen2.5:latest"}]
#   - 远程 OpenAI 兼容端点示例（api_key 也可在「模型管理」UI 填，Fernet 加密落库）：
# BUILTIN_MODELS=[{"id":"deepseek","provider":"openai_compat","base_url":"https://api.deepseek.com/v1","model_name":"deepseek-chat","api_key":"你的key"}]
# 家长自定义模型的 api_key 加密密钥（留空则使用进程内随机密钥，重启失效；生产务必显式设置）
MODEL_APIKEY_SECRET=
# 真实连通 smoke 测试（需先按 BUILTIN_MODELS 配好 Ollama 模型）：
#   BUILTIN_MODELS='[{"id":"local-llama","provider":"ollama","base_url":"http://localhost:11434","model_name":"qwen2.5:latest"}]' RUN_LLM_SMOKE=1 uv run pytest tests/domain/test_llm_smoke.py -m smoke -v
