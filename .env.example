# 复制为 .env 后填写。后端从仓库根目录的 .env 读取。
PROJECT_NAME=娃娃学习App
SECRET_KEY=请改为随机字符串

# 本地用 SQLite；部署到云用 PostgreSQL 连接串
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

FASTAPI_ENV=development

# 出题引擎：mock（无需 key，跑通闭环）| langchain（接真实大模型）| deepseek（快捷预设）
# 未知值会回退 mock 并告警。显式选 langchain/deepseek 但没配好端点会在启动时报错。
LLM_PROVIDER=mock
# 方式一：通用 OpenAI 兼容端点（混元/通义等），配 LLM_PROVIDER=langchain
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-lite
# LLM_API_KEY=你的key
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.3
# 方式二：DeepSeek 快捷预设，配 LLM_PROVIDER=deepseek，无需填上面 LLM_* 三项
# 模型默认 deepseek-chat，端点默认 https://api.deepseek.com（OpenAI 兼容）
DEEPSEEK_API_KEY=你的deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 真实连通 smoke 测试：设 LLM_PROVIDER=deepseek 且 RUN_LLM_SMOKE=1
#   LLM_PROVIDER=deepseek RUN_LLM_SMOKE=1 uv run pytest tests/domain/test_llm_smoke.py -m smoke -v
