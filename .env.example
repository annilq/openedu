# 环境变量模板。
#
# 本地开发请复制本文件到 **backend/.env**（首选）：
#     cp .env.example backend/.env
# 后端的加载顺序是 `../.env` → `.env`，后者覆盖前者；仓库根 `.env` 仅作兼容遗留保留，
# 请勿依赖（历史上根 `.env` 被改名后 SECRET_KEY 静默回落默认值，导致已存 API Key 全部
# 解不开 —— 事故与处置见 docs/adr/0038）。
PROJECT_NAME=娃娃学习App

# JWT 签名密钥。留默认值 `changeme` 时开发环境只告警，生产直接启动失败。
SECRET_KEY=请改为随机字符串

# 本地用 SQLite；部署到云用 PostgreSQL 连接串
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

FASTAPI_ENV=development

# ===== AI 模型 =====
# 模型一律在客户端「模型管理」里手动添加（家长 ModelConfig，api_key 经 Fernet 加密落库），
# 无内置模型目录、无本地 LLM_PROVIDER / DEEPSEEK_* 等旁路 env（ADR-0039）。
# 未添加任何模型时，出题 / 答疑 / 批改返回「未配置模型」提示。

# 加密 ModelConfig.api_key 的 Fernet 派生密钥（SHA-256 → base64）。
# 留空则回落 SECRET_KEY 派生 —— 那样一旦 SECRET_KEY 变更，所有已存密文立即失效。
# 请显式固定为一段随机串，且此后不要更改；变更后需在「模型管理」里重填所有模型的 Key。
MODEL_APIKEY_SECRET=

# 本地 Ollama 地址（仅 provider=ollama 且未填 base_url 时作为兜底）
OLLAMA_BASE_URL=http://localhost:11434

# ===== 真实模型 smoke 测试（默认跳过）=====
#   RUN_LLM_SMOKE=1 SMOKE_MODEL_NAME=llama3 SMOKE_MODEL_API_KEY=ollama \
#       uv run pytest tests/domain/test_llm_smoke.py -m smoke -v
