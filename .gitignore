# ── 环境与密钥 ──
.env
.env.*
!.env.example
*.pem
.secret_key

# ── Python / 后端 ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
backend/app.db
backend/test_app.db
# 资料库上传落盘目录（家长私有 PDF / docx，不进版本库）
backend/data/
# 本地数据库备份（迁移/修复前的快照，非版本控制对象）
# 两种分隔符都要覆盖：脚本产出过 `.bak-20260101` 也产出过 `.bak.20261008`
backend/app.db.bak-*
backend/app.db.bak.*
app.db.bak-*
app.db.bak.*

# ── 本地素材（大二进制，教材原始 PDF 等，不进版本库）──
resources/

# ── Flutter / 前端 ──
frontend/.dart_tool/
frontend/build/
frontend/.idea/
*.iml
# widget 测试截图工作台的落盘产物（人工目检用，非版本控制对象）
frontend/test/_shots/

# ── 系统 ──
.DS_Store

# ── 申报交付物（生成产物不进版本库；.md/.py 源文件仍跟踪）──
submission_docs/**/*.docx
submission_docs/**/*.mp4
submission_docs/**/*.zip
submission_docs/figures/
submission_docs/out/
submission_docs/raw/
submission_docs/subs/
submission_docs/voice/
