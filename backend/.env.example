# 配置说明见仓库根目录 .env.example（config.py 优先读取 ../.env，本文件为容器内兜底）
# ===== 数据库 =====
# SQLModel 同步引擎：本地 SQLite 零依赖；生产用 PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# ===== 安全 =====
SECRET_KEY=请改成一段随机长字符串

# ===== LLM provider（可插拔，ADR-003 / T03）=====
# mock        = 内置示例题，无需任何 key，保证闭环可演示（推荐先跑通）
# langchain   = 真实调用大模型（OpenAI 兼容端点，换厂商只需改 base_url/model）
# 未知值会回退 mock 并告警
LLM_PROVIDER=mock

# 真实模型时填写：
LLM_API_KEY=
LLM_BASE_URL=      # 如 https://api.hunyuan.cloud.tencent.com/v1
LLM_MODEL=         # 如 hunyuan-lite / gpt-4o-mini
LLM_TEMPERATURE=0.3
