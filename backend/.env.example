# 本地开发环境变量模板（首选位置）。
#
#     cp backend/.env.example backend/.env
#
# 加载顺序：`../.env`（兼容遗留）→ `.env`（本文件，覆盖前者）；容器内由环境变量注入。
# 完整说明见仓库根 .env.example。

# ===== 数据库 =====
# SQLModel 同步引擎：本地 SQLite 零依赖；生产用 PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# ===== 安全 =====
# JWT 签名密钥。留默认值 `changeme` 时开发环境只告警，生产直接启动失败。
SECRET_KEY=请改成一段随机长字符串

# ===== AI 模型（ADR-0039）=====
# 模型一律在「模型管理」里手动添加，无内置目录、无本地 LLM_PROVIDER / DEEPSEEK_* 旁路。
# 此处只保留两项与引擎相关的基础配置：

# 加密 ModelConfig.api_key 的 Fernet 派生密钥。留空则回落 SECRET_KEY 派生 ——
# 一旦 SECRET_KEY 变更，已存密文全部失效（事故见 docs/adr/0038）。请显式固定且不要更改。
MODEL_APIKEY_SECRET=

# provider=ollama 且未填 base_url 时的兜底地址
OLLAMA_BASE_URL=http://localhost:11434
