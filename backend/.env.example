# 本地开发环境变量模板（首选位置）。
#
#     cp backend/.env.example backend/.env
#
# 加载顺序：`../.env`（兼容遗留）→ `.env`（本文件，覆盖前者）；容器内由环境变量注入。
# 完整说明见仓库根 .env.example。

# ===== 数据库 =====
# SQLModel 同步引擎：本地 SQLite 零依赖；生产用 PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# ===== 安全 =====
# JWT 签名密钥。留默认值 `changeme` 时开发环境只告警，生产直接启动失败。
SECRET_KEY=请改成一段随机长字符串

# ===== AI 模型（ADR-0039）=====
# 模型一律在「模型管理」里手动添加，无内置目录、无本地 LLM_PROVIDER / DEEPSEEK_* 旁路。
# 此处只保留两项与引擎相关的基础配置：

# 加密 ModelConfig.api_key 的 Fernet 派生密钥。留空则回落 SECRET_KEY 派生 ——
# 一旦 SECRET_KEY 变更，已存密文全部失效（事故见 docs/adr/0038）。请显式固定且不要更改。
MODEL_APIKEY_SECRET=

# provider=ollama 且未填 base_url 时的兜底地址
OLLAMA_BASE_URL=http://localhost:11434

# ===== 资料库 / RAG 出题（ADR-0055）=====
# embedding 是服务端基础设施，**不进「模型管理」**（显式豁免 ADR-0039）：向量与模型绑定是
# 物理约束，若跟着家长聊天模型走，换一次默认模型 → 全部存量向量跨空间作废。
#
# EMBEDDING_PROVIDER: none（默认，向量化端点显式报错）/ ollama / openai_compat
# EMBEDDING_MODEL:    同时充当向量版本戳，**定下后不要改**（改 = 存量资料标 stale 待重算）
# EMBEDDING_BASE_URL: ollama 填根地址（内部拼 /api/embed）；openai_compat 填带 /v1 的根
#                      （内部拼 /embeddings）；留空时 ollama 回落 OLLAMA_BASE_URL
# EMBEDDING_API_KEY:  仅 openai_compat 需要，ollama 留空
# 本地 Ollama 推荐：先 `ollama pull bge-m3`，再照下面两行填。
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 检索实现：mock = 内置自编知识点库（无版权风险，闭环可用）；
# vector = 家长私有资料库向量检索（需出题/答疑上下文提供 session + parent_id；
#          未向量化任何资料时不报错，只是检索结果为空）
RETRIEVER_PROVIDER=mock
